# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JWT tokens. A secure default is provided.
JWT_SECRET="mock_interview_super_secret_jwt_key_2026"

# MONGODB_URI: Optional MongoDB Atlas connection string.
# If omitted or unavailable, the application automatically uses resilient local persistent storage.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/ai_mock_interview?retryWrites=true&w=majority"
